
    <!-- Add Food Modal (Hidden by default) -->
    <div class="hidden fixed inset-0 z-50 flex items-end justify-center" id="addFoodModal">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/10 backdrop-blur-sm z-10 transition-opacity duration-300 opacity-0" id="add-food-backdrop"></div>
        <!-- Modal Content -->
        <div class="relative w-full max-w-sm bg-[#F0F2F8] rounded-t-[32px] shadow-[0_-8px_30px_rgba(0,0,0,0.05)] p-6 z-20 flex flex-col items-center transform transition-transform duration-300 translate-y-full pb-8 max-h-[90dvh] overflow-y-auto" id="addFoodModalContent">
            <!-- Drag Handle (Mobile) -->
            <div class="w-12 h-1.5 bg-gray-300 rounded-full mb-6 cursor-pointer" id="close-add-food-handle"></div>
            <div class="flex justify-between items-center mb-6">
                <h2 class="font-headline-md text-headline-md text-on-surface" id="modalMealTitle">Yiyecek Ekle</h2>
                <button class="w-8 h-8 flex items-center justify-center bg-background shadow-neo rounded-full text-on-surface-variant hover:bg-surface-container-high transition-colors" class="close-add-food-modal-btn">
                    <span class="material-symbols-rounded icon-md">close</span>
                </button>
            </div>
            <div class="flex flex-col gap-4">
                <div>
                    <label class="block font-label-md text-label-md text-on-surface-variant mb-1 ml-1">Yiyecek Adı</label>
                    <input class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-[32px] px-4 py-3 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all shadow-neo-inset border-none rounded-xl bg-background " placeholder="Örn: Elma" type="text">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1 ml-1">Kalori (kcal)</label>
                        <input class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-[32px] px-4 py-3 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all shadow-neo-inset border-none rounded-xl bg-background " placeholder="0" type="number" min="0">
                    </div>
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1 ml-1">Porsiyon</label>
                        <input class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-[32px] px-4 py-3 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all shadow-neo-inset border-none rounded-xl bg-background " placeholder="1 Adet" type="text">
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-3 mt-2">
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1 ml-1">Protein (g)</label>
                        <input class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-lg px-3 py-2 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all text-center shadow-neo-inset border-none rounded-xl bg-background " placeholder="0" type="number" min="0">
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1 ml-1">Karb (g)</label>
                        <input class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-lg px-3 py-2 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all text-center shadow-neo-inset border-none rounded-xl bg-background " placeholder="0" type="number" min="0">
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1 ml-1">Yağ (g)</label>
                        <input class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-lg px-3 py-2 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all text-center shadow-neo-inset border-none rounded-xl bg-background " placeholder="0" type="number" min="0">
                    </div>
                </div>
                <button class="w-full h-[56px] bg-gradient-to-r from-neon-purple to-neon-blue text-white rounded-full flex items-center justify-center gap-2 hover:opacity-95 active:scale-[0.98] transition-all shadow-sm font-label-md text-label-md tracking-wide">
                    Kaydet
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Add Modal (Hidden by default) -->
    <div class="hidden fixed inset-0 z-50 flex items-end justify-center" id="quickAddModal">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/10 backdrop-blur-sm z-10 transition-opacity duration-300 opacity-0" id="quick-add-backdrop"></div>
        <!-- Modal Content -->
        <div class="relative w-full max-w-sm bg-[#F0F2F8] rounded-t-[32px] shadow-[0_-8px_30px_rgba(0,0,0,0.05)] p-6 z-20 flex flex-col items-center transform transition-transform duration-300 translate-y-full pb-8 max-h-[90dvh] overflow-y-auto" id="quickAddModalContent">
            <!-- Drag Handle (Mobile) -->
            <div class="w-12 h-1.5 bg-gray-300 rounded-full mb-6 cursor-pointer" id="close-quick-add-handle"></div>
            
            <div class="flex justify-between items-center mb-6 w-full">
                <h2 class="font-headline-md text-headline-md text-on-surface">Hızlı Ekle (Arama)</h2>
                <button class="w-8 h-8 flex items-center justify-center bg-background shadow-neo rounded-full text-on-surface-variant hover:bg-surface-container-high transition-colors close-quick-add-modal-btn">
                    <span class="material-symbols-rounded icon-md">close</span>
                </button>
            </div>

            <!-- Arama Alanı -->
            <div class="flex flex-col gap-2 w-full mb-4">
                <div class="flex gap-2">
                    <input id="quick-add-search-input" class="flex-1 bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-[32px] px-4 py-3 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all shadow-neo-inset border-none bg-background" placeholder="Arama (Örn: Elma)" type="text">
                    <button id="quick-add-search-btn" class="w-12 h-12 flex items-center justify-center rounded-full bg-[#F0F2F8] active:scale-95 transition-transform" style="background-color: #F0F2F8; box-shadow: 4px 4px 8px #D1D9E6, -4px -4px 8px #FFFFFF;">
                        <span class="material-symbols-rounded text-primary">search</span>
                    </button>
                </div>
                <div id="quick-add-search-results" class="flex flex-col gap-2 mt-2 max-h-40 overflow-y-auto hidden w-full px-1">
                    <!-- Sonuçlar buraya dinamik eklenecek -->
                </div>
            </div>

            <!-- Form Alanı -->
            <div class="flex flex-col gap-4 w-full">
                <div>
                    <label class="block font-label-md text-label-md text-on-surface-variant mb-1 ml-1">Öğün/Besin Adı</label>
                    <input id="quick-add-name" class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-[32px] px-4 py-3 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all shadow-neo-inset border-none rounded-xl bg-background " placeholder="Örn: Elma" type="text">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label id="quick-add-gram-label" class="block font-label-md text-label-md text-on-surface-variant mb-1 ml-1">Gram</label>
                        <input id="quick-add-gram" class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-[32px] px-4 py-3 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all shadow-neo-inset border-none rounded-xl bg-background " placeholder="100" type="number" min="0">
                    </div>
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant mb-1 ml-1">Kalori (kcal)</label>
                        <input id="quick-add-kcal" class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-[32px] px-4 py-3 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all shadow-neo-inset border-none rounded-xl bg-background " placeholder="0" type="number" min="0">
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-3 mt-2">
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1 ml-1">Protein (g)</label>
                        <input id="quick-add-protein" class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-lg px-3 py-2 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all text-center shadow-neo-inset border-none rounded-xl bg-background " placeholder="0" type="number" min="0">
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1 ml-1">Karb (g)</label>
                        <input id="quick-add-karb" class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-lg px-3 py-2 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all text-center shadow-neo-inset border-none rounded-xl bg-background " placeholder="0" type="number" min="0">
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1 ml-1">Yağ (g)</label>
                        <input id="quick-add-yag" class="w-full bg-background focus:border-primary focus:ring-1 focus:ring-primary rounded-lg px-3 py-2 font-body-md text-body-md text-on-surface placeholder:text-outline outline-none transition-all text-center shadow-neo-inset border-none rounded-xl bg-background " placeholder="0" type="number" min="0">
                    </div>
                </div>
                <button id="quick-add-save-btn" class="w-full h-[56px] bg-gradient-to-r from-neon-purple to-neon-blue text-white rounded-full flex items-center justify-center gap-2 hover:opacity-95 active:scale-[0.98] transition-all shadow-sm font-label-md text-label-md tracking-wide">
                    Kaydet
                </button>
            </div>
        </div>
    </div>


<!-- Modal for Add Portion (Hidden by default) -->
<div class="hidden fixed inset-0 z-50 flex items-end justify-center" id="addPortionModal">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/10 backdrop-blur-sm z-10 transition-opacity duration-300 opacity-0" id="add-portion-backdrop"></div>
    <!-- Modal Content -->
    <div class="relative w-full max-w-sm bg-[#F0F2F8] rounded-t-[32px] shadow-[0_-8px_30px_rgba(0,0,0,0.05)] p-6 z-20 flex flex-col items-center transform transition-transform duration-300 translate-y-full pb-8" id="addPortionModalContent">
        <!-- Drag Handle (Mobile) -->
        <div class="w-12 h-1.5 bg-gray-300 rounded-full mb-6 cursor-pointer" id="close-portion-handle"></div>
        <div class="w-full text-center mb-6">
            <h2 class="text-xl font-bold text-gray-800 mb-2" id="portion-modal-title">Porsiyon Ekle</h2>
        </div>
        <!-- Input Area -->
        <div class="flex items-center justify-between w-full px-4 mb-6">
            <button aria-label="Decrease amount" class="neo-button w-14 h-14 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-blue focus:outline-none" id="portion-minus-btn">
                <span class="material-symbols-rounded font-bold text-2xl" style="font-variation-settings: 'FILL' 1;">remove</span>
            </button>
            <div class="flex flex-col items-center justify-center w-32 h-32 rounded-full shadow-neumorphic-inset bg-[#F0F2F8]">
                <input type="number" inputmode="numeric" pattern="[0-9]*" class="text-3xl font-extrabold text-gray-800 bg-transparent text-center outline-none border-none focus:ring-0 m-0 p-0 w-24" id="portion-gram-display" value="100">
                <span class="text-sm font-semibold text-silk-blue mt-1">gr</span>
                <span class="text-sm font-medium text-gray-800/60 mt-1" id="portion-kcal-display">150 kcal</span>
            </div>
            <button aria-label="Increase amount" class="neo-button w-14 h-14 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-green focus:outline-none" id="portion-plus-btn">
                <span class="material-symbols-rounded font-bold text-2xl" style="font-variation-settings: 'FILL' 1;">add</span>
            </button>
        </div>
        <!-- CTA Button -->
        <button id="add-food-to-log-btn" class="w-full py-4 px-6 rounded-full font-bold text-lg text-gray-800 gradient-border shadow-md focus:outline-none active:scale-[0.98] transition-transform flex items-center justify-center gap-2">
            Porsiyon Ekle
        </button>
    </div>
</div>
<!-- Modal for Adding New Food to Library (Hidden by default) -->
<div class="hidden fixed inset-0 z-50 flex items-end justify-center" id="newFoodModal">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/10 backdrop-blur-sm z-10 transition-opacity duration-300 opacity-0" id="new-food-backdrop"></div>

    <!-- Modal Content -->
    <div class="relative w-full max-w-sm bg-[#F0F2F8] rounded-t-[32px] shadow-[0_-8px_30px_rgba(0,0,0,0.05)] p-6 z-20 flex flex-col items-center transform transition-transform duration-300 translate-y-full pb-8" id="newFoodModalContent">
        <!-- Drag Handle (Mobile) -->
        <div class="w-12 h-1.5 bg-gray-300 rounded-full mb-6 cursor-pointer" id="close-new-food-handle"></div>
        <div class="w-full text-center mb-6">
            <h2 class="text-xl font-bold text-gray-800 mb-2">Besin Ekle</h2>
        </div>
        <!-- Input Area -->
        <div class="w-full px-4 mb-6">
            <div class="relative flex items-center w-full h-14 px-6 rounded-full bg-[#F0F2F8] shadow-neumorphic-inset">
                <span class="material-symbols-rounded text-gray-500 mr-3">restaurant</span>
                <input type="text" id="new-food-name" placeholder="Örn: Izgara Tavuk" class="bg-transparent border-none focus:ring-0 w-full text-gray-800 placeholder-gray-500 font-semibold text-sm outline-none">
            </div>
        </div>
        <div class="flex items-center justify-between w-full px-4 mb-6">
            <button aria-label="Decrease amount" class="neo-button w-14 h-14 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-blue focus:outline-none" id="new-food-kcal-minus">
                <span class="material-symbols-rounded font-bold text-2xl" style="font-variation-settings: 'FILL' 1;">remove</span>
            </button>
            <div class="flex flex-col items-center justify-center w-32 h-32 rounded-full shadow-neumorphic-inset bg-[#F0F2F8]">
                <input type="number" inputmode="numeric" pattern="[0-9]*" class="text-3xl font-extrabold text-gray-800 bg-transparent text-center outline-none border-none focus:ring-0 m-0 p-0 w-24 appearance-none" id="new-food-kcal-display" value="100">
                <span class="text-sm font-semibold text-silk-blue mt-1">kcal</span>
            </div>
            <button aria-label="Increase amount" class="neo-button w-14 h-14 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-green focus:outline-none" id="new-food-kcal-plus">
                <span class="material-symbols-rounded font-bold text-2xl" style="font-variation-settings: 'FILL' 1;">add</span>
            </button>
        </div>
        <div class="w-full flex flex-col gap-2 mb-6">
            <div class="flex items-center justify-between bg-[#F0F2F8] p-4 rounded-2xl shadow-neumorphic-inset">
                <div class="flex flex-col">
                    <span class="text-xs font-bold text-silk-blue uppercase">Protein</span>
                    <div class="flex items-center gap-1"><input type="number" inputmode="numeric" pattern="[0-9]*" class="text-lg font-bold text-gray-800 bg-transparent text-right outline-none border-none focus:ring-0 m-0 p-0 w-12 appearance-none" id="new-food-protein-display" value="0"><span class="text-xs text-gray-500">gr</span></div>
                </div>
                <div class="flex gap-2">
                    <button id="new-food-protein-minus" class="neo-button w-10 h-10 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-blue"><span class="material-symbols-rounded text-xl">remove</span></button>
                    <button id="new-food-protein-plus" class="neo-button w-10 h-10 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-green"><span class="material-symbols-rounded text-xl">add</span></button>
                </div>
            </div>
            <div class="flex items-center justify-between bg-[#F0F2F8] p-4 rounded-2xl shadow-neumorphic-inset">
                <div class="flex flex-col">
                    <span class="text-xs font-bold text-silk-blue uppercase">Karbonhidrat</span>
                    <div class="flex items-center gap-1"><input type="number" inputmode="numeric" pattern="[0-9]*" class="text-lg font-bold text-gray-800 bg-transparent text-right outline-none border-none focus:ring-0 m-0 p-0 w-12 appearance-none" id="new-food-karb-display" value="0"><span class="text-xs text-gray-500">gr</span></div>
                </div>
                <div class="flex gap-2">
                    <button id="new-food-karb-minus" class="neo-button w-10 h-10 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-blue"><span class="material-symbols-rounded text-xl">remove</span></button>
                    <button id="new-food-karb-plus" class="neo-button w-10 h-10 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-green"><span class="material-symbols-rounded text-xl">add</span></button>
                </div>
            </div>
            <div class="flex items-center justify-between bg-[#F0F2F8] p-4 rounded-2xl shadow-neumorphic-inset">
                <div class="flex flex-col">
                    <span class="text-xs font-bold text-silk-blue uppercase">Yağ</span>
                    <div class="flex items-center gap-1"><input type="number" inputmode="numeric" pattern="[0-9]*" class="text-lg font-bold text-gray-800 bg-transparent text-right outline-none border-none focus:ring-0 m-0 p-0 w-12 appearance-none" id="new-food-yag-display" value="0"><span class="text-xs text-gray-500">gr</span></div>
                </div>
                <div class="flex gap-2">
                    <button id="new-food-yag-minus" class="neo-button w-10 h-10 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-blue"><span class="material-symbols-rounded text-xl">remove</span></button>
                    <button id="new-food-yag-plus" class="neo-button w-10 h-10 rounded-full flex items-center justify-center bg-[#F0F2F8] text-silk-green"><span class="material-symbols-rounded text-xl">add</span></button>
                </div>
            </div>
        </div>
        <!-- CTA Button -->
        <button id="save-new-food-btn" class="w-full py-4 px-6 rounded-full font-bold text-lg text-gray-800 gradient-border shadow-md focus:outline-none active:scale-[0.98] transition-transform flex items-center justify-center gap-2">Besini Kaydet<span class="material-symbols-rounded text-silk-blue" style="font-variation-settings: 'FILL' 1;">check_circle</span></button>
    </div>
</div>

